BEGIN

COMMENT CHECK IF TWO STRINGS (REPRESENTED AS INTEGER ARRAYS OF CHAR CODES);
COMMENT MAIN LOGIC ASSUMES STRINGS PASSED AS ARRAYS WITH LENGTHS (NO ARGC/ARGV IN STANDARD ALGOL-60);
COMMENT FOR DEMONSTRATION, HARD-CODE EXAMPLE OR USE EXTERNAL INPUT;

INTEGER ARRAY STR1[1:10], STR2[1:10];
COMMENT ...  (POPULATE ARRAYS AND LENGTHS HERE); IF IS_ISOMORPHIC(STR1, STR2, 10, ARE ISOMORPHIC;

BOOLEAN PROCEDURE IS_ISOMORPHIC(S1, S2, LEN1, LEN2);
	INTEGER ARRAY S1, S2;
	INTEGER LEN1, LEN2;
	BEGIN
		INTEGER I, LENI, C1, C2;
		INTEGER ARRAY MAP1[0:127], MAP2[0:127];
		FOR I := 0 STEP 1 UNTIL 127 DO
			BEGIN
				MAP1[I] := 0;
				MAP2[I] := 0
			END;
		IF LEN1 > LEN2 THEN LENI := LEN2 ELSE LENI := LEN1;
		FOR I := 1 STEP 1 UNTIL LENI DO
		BEGIN
			C1 := S1[I];
			C2 := S2[I];
			IF MAP1[C1] = 0 THEN MAP1[C1] := C2
			ELSE IF MAP1[C1] <> C2 THEN
			BEGIN
				IS_ISOMORPHIC := FALSE;
				GOTO EXIT
			END;
			IF MAP2[C2] = 0 THEN MAP2[C2] := C1
			ELSE IF MAP2[C2] <> C1 THEN
			BEGIN
				IS_ISOMORPHIC := FALSE;
				GOTO EXIT
			END
		END;
		IS_ISOMORPHIC := TRUE;
		EXIT:
	END;

COMMENT MAIN LOGIC ASSUMES STRINGS PASSED AS ARRAYS WITH LENGTHS (NO ARGC/ARGV IN STANDARD ALGOL-60);
COMMENT FOR DEMONSTRATION, HARD-CODE EXAMPLE OR USE EXTERNAL INPUT;

INTEGER ARRAY STR1[1:10], STR2[1:10];

STR[0]='P';
STR[1]='A';
STR[2]='P';
STR[3]='E';
STR[4]='R';
STR[5]=0;

STR[0]='T';
STR[1]='I';
STR[2]='T';
STR[3]='L';
STR[4]='E';
STR[5]='0';

COMMENT ...  (POPULATE ARRAYS AND LENGTHS HERE);

IF IS_ISOMORPHIC(STR1, STR2, 10, 10) THEN OUTSTRING("ISOMORPHIC")

END
